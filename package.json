{
  "name": "pi-workbench",
  "version": "0.7.0",
  "description": "Sreeram's personal Pi profile for planning, research, delegated implementation, recorded verification, and durable context.",
  "private": true,
  "type": "module",
  "author": "Sreeram Balamurugan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsreeram08/pi-workbench.git"
  },
  "homepage": "https://github.com/bsreeram08/pi-workbench#readme",
  "bugs": {
    "url": "https://github.com/bsreeram08/pi-workbench/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "multi-agent",
    "agent-memory",
    "research",
    "typescript"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test --timeout=60000 tests",
    "typecheck": "node scripts/typecheck.mjs",
    "public-check": "node scripts/check-public-release.mjs",
    "capabilities:check": "python3 scripts/check-capabilities.py",
    "release-check": "node scripts/check-public-release.mjs --history && bun audit --audit-level=high && bun run test && bun run typecheck",
    "check": "bun run public-check && bun run test && bun run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
